# Copiez ce fichier en .env.local et remplissez les valeurs.
# En production (ex. Vercel), définissez ces variables dans les paramètres du projet.

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Après déploiement : dans Supabase (Authentication → URL Configuration),
# ajoutez l’URL de production dans "Redirect URLs", ex. :
# https://votre-app.vercel.app/auth/callback
